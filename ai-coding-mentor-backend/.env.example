# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_mentor?schema=public"

# JWT
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OpenAI (optional - app works with fallback responses)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
